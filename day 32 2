#include <stdio.h>

int main() {
    long long num;
    int count[10] = {0};
    int digit, maxDigit = 0;

    printf("Enter a number: ");
    scanf("%lld", &num);

    // Count frequency of each digit
    while (num != 0) {
        digit = num % 10;
        if (digit < 0)
            digit = -digit;

        count[digit]++;
        num /= 10;
    }

    // Find digit with maximum frequency
    for (int i = 1; i < 10; i++) {
        if (count[i] > count[maxDigit]) {
            maxDigit = i;
        }
    }

    printf("Most occurring digit = %d\n", maxDigit);
    printf("Number of occurrences = %d\n", count[maxDigit]);

    return 0;
}
