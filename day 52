#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> arr = {1, 2, 8, 10, 11, 12, 19};
    int x = 5;

    int low = 0, high = arr.size() - 1;
    int ans = -1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] >= x) {
            ans = mid;      // Possible answer
            high = mid - 1; // Search for first occurrence
        } else {
            low = mid + 1;
        }
    }

    cout << ans << endl;

    return 0;
}
