#include <stdio.h>

int main() {
    int a[5], b[5], merged[10];
    int i;

    printf("Enter 5 elements for first array:\n");
    for (i = 0; i < 5; i++) {
        scanf("%d", &a[i]);
    }

    printf("Enter 5 elements for second array:\n");
    for (i = 0; i < 5; i++) {
        scanf("%d", &b[i]);
    }

    // Copy first array
    for (i = 0; i < 5; i++) {
        merged[i] = a[i];
    }

    // Copy second array
    for (i = 0; i < 5; i++) {
        merged[i + 5] = b[i];
    }

    printf("Merged array:\n");
    for (i = 0; i < 10; i++) {
        printf("%d ", merged[i]);
    }

    return 0;
}
